# ==========================================
# 🛑 AgentClaw Production .gitignore
# ==========================================

# 📦 Dependencies
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# 🔨 Build & Compilation Outputs
# dist/ (tracked for zero-memory Railway deployment)
build/
out/
*.tsbuildinfo

# 📄 Documentation & Reports (Exclude all .md except README files)
*.md
!README.md
!README*.md

# 🗄️ Database Files & Local State Storage
data/
db/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
.cashclaw/
.agentclaw/

# 🔐 Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt
*.pfx

# 🧪 Execution Sandbox & Temporary Files
tmp/
temp/
.sandbox_tmp/
scratch/
coverage/
.nyc_output/
*.tmp

# 📝 Logs & Process Management
*.log
logs/
pids/
*.pid
*.seed
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 💻 Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 🎨 IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~