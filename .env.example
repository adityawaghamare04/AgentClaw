# CashClaw Backend Environment Configuration
# All sensitive credentials MUST be configured here on the backend and NOT on the UI.

# LLM API Keys (Backend Only)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Default Provider & Model
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Agent Treasury & Payout Wallet (Where earnings are received)
TREASURY_ADDRESS=
AGENT_PRIVATE_KEY=

# Server Configuration
AGENTCLAW_PORT=3777
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
