# ==============================================================================
# 🚀 AgentClaw Production Environment Configuration (Render / Cloud Deployment)
# ==============================================================================

# 🌐 Server & Port Setup
PORT=3777
AGENTCLAW_PORT=3777
NODE_ENV=production

# 🧠 LLM Multi-Key Router & Failover Mesh
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Keys (Supports comma-separated keys for rate-limit failover & rotation)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
OPENROUTER_API_KEYS=your_openrouter_api_key_1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 🔐 AES-256-GCM Vault & Enclave Master Passphrase
VAULT_PASSPHRASE=Your_Super_Secret_Vault_Passphrase_2026!
ADMIN_PASSWORD=Your_Admin_Password_Here

# 💰 Web3 Treasury & Settlement Wallet (Base L2)
TREASURY_ADDRESS=0xYourTreasuryWalletAddressOnBase
ETH_PRIVATE_KEY=0xYourEthereumPrivateKeyForOnChainSettlement

# 🔔 Proactive Alerts & Notification Webhook
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=


